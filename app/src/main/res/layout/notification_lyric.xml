<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ 逐字歌词通知的自定义布局 喵~

  为什么要自定义布局：
      标准通知的 setContentText 是【纯文本】，没法给单个字上不同的颜色 ✗
      用 RemoteViews + TextView 才能塞 SpannableString（每个字一个颜色）✓

  颜色（跟随 MusicTage 的青蓝主题）：
      已唱的字  #6FC8FF（亮青）
      未唱的字  #7A8899（灰）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- ★ 逐字高亮的那一行 -->
    <TextView
        android:id="@+id/lyric_word_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#E8EEF6"
        android:includeFontPadding="false"
        tools:ignore="UnusedAttribute" />

    <!-- ★ 译文（没有就隐藏） -->
    <TextView
        android:id="@+id/lyric_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textColor="#9FC4E0"
        android:visibility="gone" />

    <!-- ★ 下一行（灰，做预览） -->
    <TextView
        android:id="@+id/lyric_next_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textColor="#6B7785"
        android:visibility="gone" />

</LinearLayout>
